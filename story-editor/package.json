{
  "name": "story-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && vite build --mode local",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "deploy:cloudrun": "npm run build && gcloud builds submit --tag us-central1-docker.pkg.dev/interactive-tales-2026/story-editor-repo/story-editor:latest . && gcloud run deploy story-editor --image us-central1-docker.pkg.dev/interactive-tales-2026/story-editor-repo/story-editor:latest --platform managed --region us-central1 --allow-unauthenticated"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "firebase": "^12.15.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "firebase-tools": "^13.12.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
