{
  "name": "ift-cloud-run",
  "version": "1.0.0",
  "description": "Interactive Fantastic Tales — Cloud Run Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "deploy": "gcloud run deploy ift-api --source . --region us-central1 --allow-unauthenticated"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.7.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^9.4.0",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
